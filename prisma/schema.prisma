generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SaleStatus {
  pending
  approved
  refunded
  chargeback
  canceled
}

model Sale {
  id            String     @id @default(cuid())
  platform      String
  transactionId String
  productId     String
  productName   String?
  amountCents   Int
  currency      String     @default("BRL")
  status        SaleStatus
  customerEmail String?
  occurredAt    DateTime
  rawPayload    Json
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  // Chave de idempotência: a mesma venda na mesma plataforma nunca vira 2 linhas.
  @@unique([platform, transactionId])
  @@index([occurredAt])
  @@index([status, occurredAt])
}
